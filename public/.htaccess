Options -Indexes
RewriteEngine On

# Jika request masih menyertakan prefix /public/, strip agar langsung menemukan file
RewriteRule ^public/(.*)$ $1 [L]

# Izinkan akses langsung ke file & folder nyata
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Semua request → index.php
RewriteRule ^(.*)$ index.php?url=$1 [QSA,L]

# Blokir akses ke file sensitif
<FilesMatch "\.(sql|log|env|ini|sh|bat)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>
